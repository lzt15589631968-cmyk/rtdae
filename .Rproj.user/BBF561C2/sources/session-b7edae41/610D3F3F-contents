#' Addressing an issue:

# https://github.com/tdaverse/phutil/issues/54

#' Reproduce the behavior.

library(TDA)
library(ripserr)
library(phutil)
X <- matrix(rnorm(20), ncol = 2)
do.call(ripsDiag, c(list(X = X, maxdimension = 2, maxscale = 10))) |>
  as_persistence()
do.call(vietoris_rips, c(list(dataset = X))) |>
  as_persistence()

#' Articulate the desired behavior.

# GOAL: First `do.call()` call should not error, but produce a `persistence`
# object like that of the second call.

#' Trace the problem / identify the culprit.

# separate `do.call()` and `as_persistence()`
res <- do.call(ripsDiag, c(list(X = X, maxdimension = 2, maxscale = 10)))
print(res)
as_persistence(res)
# confirm problem lies with `diagram` method
phutil:::as_persistence.diagram(res$diagram)

# walk through internals of this method
x = res$diagram
# internals of `as_persistence.diagram()`
info <- attributes(x)
names(info)
stopifnot(
  info$dimnames[[2L]][1L] == "dimension",
  all(c("Birth", "Death") %in% info$dimnames[[2L]][c(2L, 3L)])
)
bd_cols <- match(c("Birth", "Death"), info$dimnames[[2L]])
filt_nm <- gsub("*Diag", "", rlang::call_name(info$call))
# reproduce error
if (filt_nm == "rips") {
  filt_nm <- "Vietoris-Rips"
}

# test for error without using `do.call()`
res2 <- ripsDiag(X, maxdimension = 2, maxscale = 10)
as_persistence(res2)

x2 = res2$diagram
# internals of `as_persistence.diagram()`
info2 <- attributes(x2)
names(info2)
stopifnot(
  info2$dimnames[[2L]][1L] == "dimension",
  all(c("Birth", "Death") %in% info2$dimnames[[2L]][c(2L, 3L)])
)
bd_cols2 <- match(c("Birth", "Death"), info2$dimnames[[2L]])
filt_nm2 <- gsub("*Diag", "", rlang::call_name(info2$call))
if (filt_nm2 == "rips") {
  filt_nm2 <- "Vietoris-Rips"
}

# compare `filt_nm`
filt_nm
filt_nm2
# compare `info$call`
info$call
info2$call
# compare `rlang::call_name(info$call)`
rlang::call_name(info$call)
rlang::call_name(info2$call)

